# =========================================================
# CaloVision AI - Mẫu Cấu hình Môi trường (.env.example)
# =========================================================

# Backend API URL (Mặc định: http://127.0.0.1:5001/api, hoặc http://<IP_LAN>:5001/api khi test trên máy thật)
EXPO_PUBLIC_API_URL=http://127.0.0.1:5001/api

# Google OAuth Web Client ID (Tạo miễn phí tại https://console.cloud.google.com/apis/credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Gemini AI API Key (Lấy tại https://aistudio.google.com/)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

